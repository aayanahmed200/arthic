# copy this file to .env and fill in real values — .env is gitignored

# port the API listens on
PORT=3001

# origin allowed to call this API (your deployed frontend's URL, no
# trailing slash). use * only for local development.
ALLOWED_ORIGIN=*

# credentials for /admin and the write endpoints (POST/PUT/DELETE journal,
# GET subscribers). pick a real password before deploying anywhere public —
# the server refuses admin requests entirely until ADMIN_PASSWORD is set.
ADMIN_USER=admin
ADMIN_PASSWORD=

# optional: override where the sqlite file is written
# DATABASE_PATH=./data/arthic.db
