# Copy to .env and fill in real values. The real .env file is gitignored.
# For Vercel, configure these in Project Settings -> Environment Variables.
# Never commit database passwords, OAuth client secrets or other private keys.

# Server-side Vercel Function variables
POSTGRES_URL=
ADMIN_USER=admin
ADMIN_PASSWORD=
# Comma-separated Google account email addresses permitted to access /admin.html
ADMIN_EMAILS=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public build-time browser variables; these must match the same Supabase project
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional only for the separate Express backend
# VITE_API_BASE=

# Never put POSTGRES_URL, ADMIN_PASSWORD, ADMIN_EMAILS or a Supabase
# secret/service-role key in a VITE_ variable.