# Copy this file to .env and fill in real values — .env is gitignored.
# Used by `vercel dev` to run the /api serverless functions locally
# alongside the Vite frontend. See ../DEPLOYMENT.md for how these get set
# in production (Vercel Project Settings → Environment Variables, not here).

# --- Server-side, read by the functions in api/ -----------------------

# Postgres connection string. Works with Supabase, Neon, or any standard
# Postgres provider — @vercel/postgres just needs a normal connection URI,
# nothing Supabase-specific. Leave unset and every API route that needs
# storage replies 503 with an honest message instead of a fake success;
# the site still works, the waitlist and apply forms just say so.
POSTGRES_URL=

# HTTP Basic Auth credentials for /admin and the write endpoints
# (GET subscribers/waitlist). Pick a real password — there's no working
# default.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Build-time, read by Vite (see src/lib/config.ts) ------------------

# Only needed if you're running the standalone Express + SQLite backend
# in ../backend instead of these serverless functions — see
# ../backend/README.md. Leave unset for the normal Vercel setup; the API
# is same-origin by default.
# VITE_API_BASE=

# --- Student identity verification (server-only) -----------------------
# Supabase project URL and publishable key. The publishable key is safe
# to identify this app; user access is still verified with the bearer
# access token. Never put a Supabase secret key in VITE_* or browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Student account registration (default off) -----------------------
# Keep false until Google OAuth, database setup, data-flow/security checks,
# and a legally reviewed age/guardian-consent and deletion process are ready.
STUDENT_ACCOUNTS_ENABLED=false

# Public Vite build-time settings. These must refer to the same Supabase
# project as the server-only settings above. Never put a secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STUDENT_ACCOUNTS_ENABLED=false
