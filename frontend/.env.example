# Copy this file to .env and fill in real values — .env is gitignored.
# Used by `vercel dev` to run the /api serverless functions locally
# alongside the Vite frontend. See ../DEPLOYMENT.md for how these get set
# in production (Vercel Project Settings → Environment Variables, not here).

# --- Server-side, read by the functions in api/ -----------------------

# Postgres connection string. Works with Supabase, Neon, or any standard
# Postgres provider — @vercel/postgres just needs a normal connection URI,
# nothing Supabase-specific. Leave unset and every API route that needs
# storage replies 503 with an honest message instead of a fake success;
# the site still works, journal/subscribe just degrade to static/offline.
POSTGRES_URL=

# HTTP Basic Auth credentials for /admin and the write endpoints
# (POST/PUT/DELETE journal, GET subscribers). Pick a real password —
# there's no working default.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Build-time, read by Vite (see src/lib/config.ts) ------------------

# Only needed if you're running the standalone Express + SQLite backend
# in ../backend instead of these serverless functions — see
# ../backend/README.md. Leave unset for the normal Vercel setup; the API
# is same-origin by default.
# VITE_API_BASE=
